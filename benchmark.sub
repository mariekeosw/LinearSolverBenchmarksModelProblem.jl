# Submit from the repository directory:
#   condor_submit benchmark.sub                              full run (results/)
#   condor_submit benchmark.sub -append "arguments = 6"      test run (results_test/)
executable              = benchmark.sh
environment             = "REPO_DIR=$ENV(PWD)"

log                     = benchmark.log
output                  = benchmark.out
error                   = benchmark.err

request_cpus = 12
request_memory = 500 GB
request_disk = 50 GB

stream_output = TRUE
stream_error = TRUE

queue